@model TheStudentManagementSystem.Models.AttendanceRecord
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Mark Attendance";
    Layout = "_DashboardLayout";
    var students = (List<SelectListItem>)ViewBag.Students;
}

<section class="panel form-panel">
    <h3>Mark Attendance</h3>

    @if (students.Count == 0)
    {
        <p class="empty">Add a student first, then come back.</p>
        <a asp-controller="Students" asp-action="Create" class="btn-primary">+ Add Student</a>
    }
    else
    {
        <form asp-controller="Attendance" asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <label asp-for="StudentId">Student</label>
            <select asp-for="StudentId" asp-items="students">
                <option value="0">-- Select student --</option>
            </select>
            <span asp-validation-for="StudentId" class="validation-error"></span>

            <label asp-for="Date">Date</label>
            <input asp-for="Date" type="date" />
            <span asp-validation-for="Date" class="validation-error"></span>

            <label asp-for="Status">Status</label>
            <select asp-for="Status">
                <option value="Present">Present</option>
                <option value="Absent">Absent</option>
                <option value="Late">Late</option>
            </select>
            <span asp-validation-for="Status" class="validation-error"></span>

            <div class="form-buttons">
                <button type="submit" class="btn-primary">Save Attendance</button>
                <a asp-controller="Attendance" asp-action="Index" class="btn-secondary">Cancel</a>
            </div>

        </form>
    }
</section>