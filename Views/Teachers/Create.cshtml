@model TheStudentManagementSystem.Models.Teacher

@{
    ViewData["Title"] = "Add Teacher";
    Layout = "_DashboardLayout";
}

<section class="panel form-panel">
    <h3>New Teacher</h3>

    <form asp-controller="Teachers" asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <label asp-for="Name">Full Name</label>
        <input asp-for="Name" maxlength="50" />
        <span asp-validation-for="Name" class="validation-error"></span>

        <label asp-for="Subject">Subject</label>
        <input asp-for="Subject" maxlength="50" />
        <span asp-validation-for="Subject" class="validation-error"></span>

        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" maxlength="100" />
        <span asp-validation-for="Email" class="validation-error"></span>

        <div class="form-buttons">
            <button type="submit" class="btn-primary">Save Teacher</button>
            <a asp-controller="Teachers" asp-action="Index" class="btn-secondary">Cancel</a>
        </div>

    </form>
</section>