@model List<TheStudentManagementSystem.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="error-box">@TempData["Error"]</div>
}

<div class="page-actions">
    <a asp-controller="Teachers" asp-action="Create" class="btn-primary">+ Add Teacher</a>
</div>

<section class="panel">
    <h3>All Teachers (@Model.Count)</h3>

    @if (Model.Count == 0)
    {
        <p class="empty">No teachers yet. Click "Add Teacher" to add the first one.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Subject</th>
                    <th>Email</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var teacher in Model)
                {
                    <tr>
                        <td>@teacher.Name</td>
                        <td>@teacher.Subject</td>
                        <td>@teacher.Email</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <form asp-controller="Teachers" asp-action="Delete" asp-route-id="@teacher.Id" method="post"
                                      onsubmit="return confirm('Delete this teacher? This cannot be undone.');">
                                    <button type="submit" class="btn-danger">Delete</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</section>