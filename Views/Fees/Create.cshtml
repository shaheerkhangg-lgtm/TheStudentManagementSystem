@model TheStudentManagementSystem.Models.Fee
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Add Fee";
    Layout = "_DashboardLayout";
    var students = (List<SelectListItem>)ViewBag.Students;
}

<section class="panel form-panel">
    <h3>New Fee</h3>

    @if (students.Count == 0)
    {
        <p class="empty">Add a student first, then come back.</p>
        <a asp-controller="Students" asp-action="Create" class="btn-primary">+ Add Student</a>
    }
    else
    {
        <form asp-controller="Fees" asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <label asp-for="StudentId">Student</label>
            <select asp-for="StudentId" asp-items="students">
                <option value="0">-- Select student --</option>
            </select>
            <span asp-validation-for="StudentId" class="validation-error"></span>

            <label asp-for="ForMonth">Month</label>
            <input asp-for="ForMonth" maxlength="30" placeholder="November 2026" />
            <span asp-validation-for="ForMonth" class="validation-error"></span>

            <label asp-for="Amount">Amount</label>
            <input asp-for="Amount" type="number" step="0.01" />
            <span asp-validation-for="Amount" class="validation-error"></span>

            <label asp-for="Status">Status</label>
            <select asp-for="Status">
                <option value="Unpaid">Unpaid</option>
                <option value="Paid">Paid</option>
            </select>
            <span asp-validation-for="Status" class="validation-error"></span>

            <div class="form-buttons">
                <button type="submit" class="btn-primary">Save Fee</button>
                <a asp-controller="Fees" asp-action="Index" class="btn-secondary">Cancel</a>
            </div>

        </form>
    }
</section>