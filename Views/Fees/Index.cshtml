@model List<TheStudentManagementSystem.Models.Fee>

@{
    ViewData["Title"] = "Fees";
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="error-box">@TempData["Error"]</div>
}

<div class="page-actions">
    <a asp-controller="Fees" asp-action="Create" class="btn-primary">+ Add Fee</a>
</div>

<section class="panel">
    <h3>All Fees (@Model.Count)</h3>

    @if (Model.Count == 0)
    {
        <p class="empty">No fees yet. Click "Add Fee" to add the first one.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Class</th>
                    <th>Month</th>
                    <th>Amount</th>
                    <th>Status</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var fee in Model)
                {
                    <tr>
                        <td>@fee.Student.Name</td>
                        <td>@fee.Student.ClassName</td>
                        <td>@fee.ForMonth</td>
                        <td>@fee.Amount.ToString("N0")</td>
                        <td>
                            <span class="badge @(fee.Status == "Paid" ? "good" : "bad")">@fee.Status</span>
                        </td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <form asp-controller="Fees" asp-action="Delete" asp-route-id="@fee.Id" method="post"
                                      onsubmit="return confirm('Delete this fee? This cannot be undone.');">
                                    <button type="submit" class="btn-danger">Delete</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</section>