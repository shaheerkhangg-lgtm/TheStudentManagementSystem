@model TheStudentManagementSystem.Models.StudentViewModel

@{
    ViewData["Title"] = "Add Student";
    Layout = "_DashboardLayout";
}

<section class="panel form-panel">
    <h3>New Student</h3>

    <form asp-controller="Students" asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <label asp-for="Name">Full Name</label>
        <input asp-for="Name" maxlength="50" />
        <span asp-validation-for="Name" class="validation-error"></span>

        <label asp-for="ClassName">Class</label>
        <input asp-for="ClassName" maxlength="30" />
        <span asp-validation-for="ClassName" class="validation-error"></span>

        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" maxlength="100" />
        <span asp-validation-for="Email" class="validation-error"></span>

        <div class="form-buttons">
            <button type="submit" class="btn-primary">Save Student</button>
            <a asp-controller="Students" asp-action="Index" class="btn-secondary">Cancel</a>
        </div>

    </form>
</section>